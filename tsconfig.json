{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "./out",
    "lib": ["ES2020"],
    // Off deliberately. A .js.map embeds the complete original TypeScript, so
    // shipping maps published the full source next to the code they mapped —
    // including the license module that carried a signing secret. .vscodeignore
    // excludes **/*.js.map as a second line of defence, but not generating them
    // is the one that cannot be undone by an ignore-pattern mistake.
    "sourceMap": false,
    "rootDir": "./src",
    "strict": true
  },
  "exclude": ["node_modules", ".vscode-test", "tests"]
}
